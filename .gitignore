# Workspace-root ignores. `latch/.gitignore` covers the ROS workspace itself;
# this file covers the rest of the tree.

# ---------------------------------------------------------------- secrets
# The provider key is read from ~/.llm_keys, which lives OUTSIDE this tree and
# must stay there. A previous project in this line leaked a key through git
# history and it had to be revoked.
*.key
.env
.llm_keys
**/secrets.*

# ------------------------------------------------------------ build output
build/
install/
log/
__pycache__/
*.py[cod]
*.egg-info/

# --------------------------------------------------- large / regenerable data
# Synthetic datasets are regenerated by tools/synth_dataset; they are hundreds
# of MB and reproducible from the capture scripts plus a seed.
datasets/
synth_obb*/
**/generated/

# Run artefacts stay in the WSL workspace. The RESULTS that the paper cites are
# an exception and are committed under paper/data/ - see the negation below.
runs/
*.jsonl
*.csv
!paper/data/*.csv

# --------------------------------------------------------------- editors / OS
.vscode/
.idea/
desktop.ini
Thumbs.db
*~
*.swp

# Not published: superseded artefacts, and the predecessor thesis plus the
# supervisor notes that set this project requirements (a third party document,
# and not needed to build, run or reproduce anything here).
attic/
paper/reference/

# Not published: unpublished manuscripts and the research ledger. They live in
# the working tree, not on the remote. What stays is what makes the code
# reproducible - the scored trials under paper/data/ and the script that draws
# figures from them.
paper/*.md
paper/figures/*.png
# paper/figures/episode/ stays tracked: like paper/data/, it is the raw
# capture a figure is redrawn from (F7), not manuscript text.
# The Overleaf projects ARE the manuscripts (LaTeX source of both papers).
paper/overleaf/
