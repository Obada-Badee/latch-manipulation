<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llm_task_planner</name>
  <version>0.0.0</version>
  <description>
    Manipulation skills as ROS 2 actions, plus an LLM planner that composes them
    from natural language against a perceived world state.
  </description>
  <maintainer email="obadabadee3@hotmail.com">Obada</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>skill_msgs</exec_depend>
  <exec_depend>yolov8_msgs</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <!-- The provider SDKs (anthropic, groq) are pip dependencies, not rosdep keys;
       tools/wsl/20-install-user.sh installs both into the user site. Neither is
       imported until its backend is selected, so a setup with only one of them
       still runs - see llm_task_planner/backends/__init__.py. -->
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
