<?xml version="1.0" ?>
<!--
  Minimal world whose only job is to prove that Gazebo's ogre2 renderer is
  GPU-accelerated under WSLg.

  Why a separate world instead of the project's own: the real camera is mounted
  on the robot, which is spawned by the ROS launch file, so measuring it needs
  the whole stack up (and a GUI on the user's desktop). This runs headless in a
  few seconds with `gz sim -s` and nothing else.

  The camera deliberately requests 30 Hz at 640x480 - the same load the project's
  camera produces. Achieving ~30 fps means hardware rendering; llvmpipe falls
  well short, which is the signal 40-check-render.sh keys on.
-->
<sdf version="1.9">
  <world name="render_probe">
    <physics name="fast" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- The system under test. Same render engine as config/panda.urdf.xacro. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Something textured enough to be worth rasterising. -->
    <model name="target">
      <static>true</static>
      <pose>0 0 0.25 0 0 0.4</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="probe_camera">
      <static>true</static>
      <pose>-2.0 0 1.0 0 0.35 0</pose>
      <link name="link">
        <sensor name="probe_cam" type="camera">
          <update_rate>30</update_rate>
          <topic>probe_cam</topic>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>1.8</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.02</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
